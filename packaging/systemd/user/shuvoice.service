[Unit]
Description=ShuVoice speech-to-text overlay
After=graphical-session.target
# Start/stop with the active graphical session only.
BindsTo=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Packaged install path. For repo/cargo workflows, override with:
#   systemctl --user edit shuvoice.service
#   [Service]
#   ExecStart=
#   ExecStart=%h/repos/shuvoice/target/release/shuvoice
ExecStart=/usr/bin/shuvoice
Restart=on-failure
RestartSec=2
# Back off retryable failures (e.g. display not reachable yet) up to 60 s
# instead of retrying every 2 s indefinitely (systemd >= 254).
RestartSteps=5
RestartMaxDelaySec=60
# Do not restart-loop when backend dependencies are missing.
RestartPreventExitStatus=78
# Optional tracing defaults for journald.
Environment=RUST_LOG=info

[Install]
WantedBy=graphical-session.target
