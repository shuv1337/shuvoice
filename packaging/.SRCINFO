pkgbase = shuvoice-git
	pkgdesc = Streaming speech-to-text overlay for Hyprland/Wayland with pluggable ASR backends
	pkgver = 0.1.3.r0
	pkgrel = 1
	url = https://github.com/shuv1337/shuvoice
	arch = x86_64
	license = MIT
	makedepends = git
	makedepends = cargo
	makedepends = rust
	makedepends = pkgconf
	makedepends = clang
	makedepends = gtk4
	makedepends = gtk4-layer-shell
	makedepends = alsa-lib
	makedepends = pipewire
	depends = gtk4
	depends = gtk4-layer-shell
	depends = alsa-lib
	depends = wtype
	depends = wl-clipboard
	depends = pipewire
	depends = pipewire-audio
	depends = pipewire-alsa
	optdepends = python: interpreter for optional NeMo / Moonshine / MeloTTS workers
	optdepends = uv: preferred tool for creating isolated worker venvs (shuvoice setup --install-missing)
	optdepends = xdotool: XWayland text injection fallback
	optdepends = ydotool: alternative text injection utility
	optdepends = piper-tts: Local Piper TTS binary
	provides = shuvoice
	conflicts = shuvoice
	options = !lto
	source = git+https://github.com/shuv1337/shuvoice.git
